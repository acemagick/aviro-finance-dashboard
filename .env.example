# Copy to .env for local development (never commit .env).
# In production (e.g. Render), set these as environment variables instead.

# Bitrix24 inbound webhook URL (server-side only; never exposed to the browser).
BITRIX_WEBHOOK_URL=https://your-portal.bitrix24.com/rest/USER_ID/WEBHOOK_CODE/

# Optional. Render sets PORT automatically; locally the server uses 3001.
# PORT=3001

# Dashboard login (HTTP Basic Auth). Required when NODE_ENV=production (npm start);
# not used in local development (npm run server + npm run dev).
DASHBOARD_USERNAME=choose-a-username
DASHBOARD_PASSWORD=choose-a-long-random-password
